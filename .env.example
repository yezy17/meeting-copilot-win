OPENAI_API_KEY=

# Translation and summary models (OpenAI Responses API).
TRANSLATION_MODEL=gpt-4.1-nano
SUMMARY_MODEL=gpt-5.4-mini

# Local Whisper speech-to-text settings.
# Model: tiny, base, small, medium, large-v3 (default: large-v3)
WHISPER_MODEL_SIZE=large-v3
# Device: cuda or cpu (default: cuda)
WHISPER_DEVICE=cuda
# Energy threshold for voice activity detection (default: 300)
WHISPER_ENERGY_THRESHOLD=300

# Meeting audio language.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=zh-CN

# Audio capture settings.
LOOPBACK_DEVICE_INDEX=
AUDIO_CHUNK_MS=120
