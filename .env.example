OPENAI_API_KEY=

# Speech-to-text on the Realtime endpoint.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Translation and summary models on the Responses API.
TRANSLATION_MODEL=gpt-4.1-nano
SUMMARY_MODEL=gpt-5.4-mini

# Meeting audio is expected to be English and translated to Simplified Chinese.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=zh-CN

# Audio is captured from the default Windows loopback device unless this is set.
LOOPBACK_DEVICE_INDEX=
AUDIO_CHUNK_MS=120
